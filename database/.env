# Environment configuration for WeatherApp Database
# Copy this to .env.local and modify as needed

# SQL Server Configuration
SQL_SA_PASSWORD='$kT_v6CGfUTIY*LB'
MSSQL_SA_PASSWORD='$kT_v6CGfUTIY*LB'
MSSQL_PID=Express
ACCEPT_EULA=Y

# Database Configuration
DB_NAME=WeatherApp
DB_PORT=1433

# Container Configuration
CONTAINER_NAME=weatherapp-database

# Network Configuration
NETWORK_NAME=weatherapp-network

# Volume Names
DATA_VOLUME=weatherapp_database_data
LOG_VOLUME=weatherapp_database_logs